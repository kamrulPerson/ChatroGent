# Root passwords (dev only)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpw
MONGO_APP_USER=rwapp
MONGO_APP_PASSWORD=rwappw
MONGO_APP_DB=remitwise

# API
API_PORT=4000
DATA_DIR=/data
DEMO_PASSWORD=demo1234
SESSION_SECRET=devsecret

# LLM (agent layer). Leave LLM_API_KEY empty to run the offline deterministic
# flow. When set, the live provider is used (Phase 2). Never commit a real key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# CORS allow-list (comma separated). Never use '*'.
CORS_ORIGIN=http://localhost:5173
# How long a payment proposal stays open for confirmation.
PROPOSAL_TTL_SECONDS=600

# Sandbox policy thresholds (product policy, not regulatory values) that feed
# the compliance engine. Defaults live in apps/api/src/config.ts.
#   VELOCITY_MAX_24H / ANOMALY_MULTIPLIER   -> VEL_01 / ANOM_01
#   TIER1_LOW_VALUE_CAP_USD                 -> KYC_01 per-transfer cap
#   DAILY_CAP_TIER0/1/2_USD                 -> daily cap business check
#   MIN_TRANSFER_USD / MAX_FEE_PCT          -> MIN_AMT minimum size / fee share
VELOCITY_MAX_24H=3
ANOMALY_MULTIPLIER=3
TIER1_LOW_VALUE_CAP_USD=1000
DAILY_CAP_TIER1_USD=1500
MIN_TRANSFER_USD=10
MAX_FEE_PCT=5
