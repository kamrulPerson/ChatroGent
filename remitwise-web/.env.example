# Web app (Vite) settings. Copy to .env and adjust. .env is gitignored.

# Use the in-memory wireframe mocks instead of the real API.
VITE_USE_MOCK=false

# Optional sandbox convenience auto-login. Leave DISABLED by default so the
# login form is shown. Set to true only for local demos and fill the demo
# account below from the seeded demo users. Never commit these values.
VITE_DEMO_AUTOLOGIN=false
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=
